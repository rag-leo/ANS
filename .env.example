# ==========================================================
# Project Metadata
# ==========================================================
PROJECT_NAME=Agri-News Intelligence System
PROJECT_VERSION=0.1.0
ENVIRONMENT=dev

# ==========================================================
# FastAPI
# ==========================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# ==========================================================
# PostgreSQL
# ==========================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# "require" for managed/cloud Postgres (e.g. Azure Database for PostgreSQL).
# Use "disable" only for a local Postgres that isn't configured for SSL.
POSTGRES_SSLMODE=require

# ==========================================================
# Azure OpenAI
# ==========================================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# Cheaper deployment (e.g. gpt-4o-mini) used only for ingestion-time
# crop/category classification, kept separate from the deployment
# above used for content generation.
AZURE_OPENAI_CLASSIFICATION_DEPLOYMENT=

# ==========================================================
# Logging
# ==========================================================
LOG_LEVEL=INFO

# ==========================================================
# CORS
# ==========================================================
# Comma-separated list of origins allowed to call this API.
# Add your deployed Streamlit frontend's URL here in production.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
